# ───── App ─────
APP_ENV=dev                    # dev / prod / test
APP_LOG_LEVEL=INFO             # DEBUG / INFO / WARNING / ERROR
APP_LOG_FORMAT=console         # console on your machine, json in the container
APP_LOG_SQL=false              # true to see every SQL query

# ───── PostgreSQL ─────
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=macro_signal_engine
# Host name is localhost here; docker-compose overrides it with `postgres`
APP_DATABASE_URL=postgresql+psycopg://app_admin:change_me@localhost:5432/macro_signal_engine

# ───── Redis ─────
APP_REDIS_URL=redis://localhost:6379/0

# ───── Secrets — generate your own, see the README ─────
APP_JWT_SECRET=
APP_FERNET_KEY=
